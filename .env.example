# AI DJ Studio — Environment Configuration Template (REQ-073)
# Copy this file to .env and replace placeholder values for local development.
# NEVER commit your actual .env file to source control.

APP_NAME=AI DJ Studio
APP_ENV=development
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CORS Origins (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (Used from Module 2 onward)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aidj_studio

# JWT & Security Configuration (Used from Module 3 onward)
JWT_SECRET_KEY=replace_with_a_strong_32_byte_secret_key
JWT_REFRESH_SECRET_KEY=replace_with_a_strong_32_byte_refresh_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# Optional AI / LLM Provider Configuration (Used in Module 10 with deterministic fallback)
LLM_PROVIDER=deterministic_fallback
LLM_API_KEY=
